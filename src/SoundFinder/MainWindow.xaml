<Window x:Class="SoundFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundFinder.Controls"
        Title="SoundFinder" Width="1280" Height="800"
        Background="#FF202020" Foreground="#FFE0E0E0">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock Text="Recherche :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
            <TextBlock Text="Bibliothèque :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}"
                      DisplayMemberPath="Name" Width="160" Margin="0,0,8,0" />
            <TextBlock Text="Durée min (s) :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding MinDuration}" Width="50" Margin="0,0,8,0" />
            <TextBlock Text="max :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding MaxDuration}" Width="50" Margin="0,0,8,0" />
            <TextBlock Text="Tag :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding TagFilter}" Width="100" Margin="0,0,8,0" />
            <Button Content="Rechercher" Command="{Binding SearchCommand}" Padding="12,2" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="+ Ajouter" Click="OnAddLibrary" Margin="0,0,4,0" Padding="8,2" />
                    <Button Content="Supprimer" Click="OnRemoveLibrary" Margin="0,0,4,0" Padding="8,2" />
                    <Button Content="Indexer" Command="{Binding IndexLibraryCommand}" Padding="8,2" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}"
                         DisplayMemberPath="Name" Background="#FF2B2B2B" Foreground="#FFE0E0E0" BorderThickness="0" />
            </DockPanel>

            <DataGrid x:Name="ResultsGrid" Grid.Column="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedSample}"
                      SelectionChanged="ResultsGrid_SelectionChanged"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,8,0"
                      Background="#FF2B2B2B" Foreground="#FFE0E0E0" RowBackground="#FF2B2B2B" AlternatingRowBackground="#FF333333">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nom" Binding="{Binding FileName}" Width="*" />
                    <DataGridTextColumn Header="Durée" Binding="{Binding DurationSeconds, StringFormat=0.00}" Width="70" />
                    <DataGridTextColumn Header="Hz" Binding="{Binding SampleRate}" Width="60" />
                    <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="120" />
                    <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}" Width="50" />
                    <DataGridTextColumn Header="Tonalité" Binding="{Binding MusicalKey}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Lecture" Command="{Binding PlayCommand}" Margin="0,0,4,0" Padding="10,2" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="0,0,4,0" Padding="10,2" />
                    <CheckBox Content="Boucle" IsChecked="{Binding Loop}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Renommer en masse" Click="OnBulkRename" Padding="10,2" />
                </StackPanel>
                <controls:WaveformControl x:Name="Waveform" Height="120" Margin="0,0,0,4" />
                <controls:SpectrumControl x:Name="Spectrum" Height="100" Margin="0,0,0,8" />
                <TextBlock Text="Métadonnées" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Tags" />
                <TextBox Text="{Binding SelectedSample.Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="BPM" />
                <TextBox Text="{Binding SelectedSample.Bpm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="Tonalité" />
                <TextBox Text="{Binding SelectedSample.MusicalKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="Commentaire" />
                <TextBox Text="{Binding SelectedSample.Comment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" Height="50" TextWrapping="Wrap" AcceptsReturn="True" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Enregistrer les métadonnées" Click="OnSaveMetadata" Margin="0,0,4,0" Padding="10,2" />
                    <CheckBox x:Name="WriteTagsToFile" Content="écrire dans le fichier" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
