<Window x:Class="SoundFinder.BulkRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renommage en masse" Width="640" Height="420"
        WindowStartupLocation="CenterOwner" Background="#FF2B2B2B" Foreground="#FFE0E0E0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Jetons : {name} {filename} {ext} {tags} {bpm} {key} {comment} {library}" Margin="0,0,0,4" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="PatternBox" Text="{name}.{ext}" Width="300" Margin="0,0,8,0" />
            <Button Content="Prévisualiser" Click="OnPreview" Padding="12,2" />
        </DockPanel>

        <ListView x:Name="PreviewList" Grid.Row="2" Background="#FF202020" Foreground="#FFE0E0E0" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ancien" DisplayMemberBinding="{Binding OldPath}" Width="240" />
                    <GridViewColumn Header="Nouveau" DisplayMemberBinding="{Binding NewPath}" Width="240" />
                    <GridViewColumn Header="Erreur" DisplayMemberBinding="{Binding Error}" Width="120" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Appliquer" Click="OnApply" Margin="0,0,8,0" Padding="12,2" />
            <Button Content="Fermer" Click="OnClose" Padding="12,2" />
        </StackPanel>
    </Grid>
</Window>
